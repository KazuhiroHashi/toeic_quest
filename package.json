{
  "name": "wordria-app",
  "version": "0.1.0",
  "private": true,
  "description": "WORDRIA - native app wrapper (Capacitor) for iOS/Android",
  "scripts": {
    "build:www": "node tools/build_www.js",
    "admob": "node tools/apply_admob.js",
    "cap:sync": "npm run build:www && npx cap sync && npm run admob && npm run appid",
    "assets": "npx @capacitor/assets generate --assetPath appicon --iconBackgroundColor '#0b1230' --iconBackgroundColorDark '#0b1230'",
    "open:android": "npm run cap:sync && npx cap open android",
    "open:ios": "npm run cap:sync && npx cap open ios",
    "ads": "node tools/set_ads.js --show",
    "ads:live": "node tools/set_ads.js --live",
    "ads:test": "node tools/set_ads.js --test",
    "appid": "node tools/apply_appid.js"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "cordova-plugin-purchase": "^13.18.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
