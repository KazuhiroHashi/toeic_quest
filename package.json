{
  "name": "wordquest-app",
  "version": "0.1.0",
  "private": true,
  "description": "WORD QUEST - native app wrapper (Capacitor) for iOS/Android",
  "scripts": {
    "build:www": "node tools/build_www.js",
    "admob": "node tools/apply_admob.js",
    "cap:sync": "npm run build:www && npx cap sync && npm run admob",
    "assets": "npx @capacitor/assets generate --assetPath appicon --iconBackgroundColor '#0b1230' --iconBackgroundColorDark '#0b1230'",
    "open:android": "npm run cap:sync && npx cap open android",
    "open:ios": "npm run cap:sync && npx cap open ios",
    "ads": "node tools/set_ads.js --show",
    "ads:live": "node tools/set_ads.js --live",
    "ads:test": "node tools/set_ads.js --test"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.0.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "cordova-plugin-purchase": "^13.12.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
